# Copy this file to .env and fill in your keys
OPENAI_API_KEY=sk-xxx
# Optional: use any OpenAI-compatible endpoint (e.g. DeepSeek, vLLM)
OPENAI_BASE_URL=
MODEL_NAME=gpt-4o-mini

# ---- OpenTelemetry ----
# Set OTEL_ENABLED=false to disable tracing/metrics entirely.
OTEL_ENABLED=true
OTEL_SERVICE_NAME=agent-demo
# OTLP endpoint (the collector). Use http://otel-collector:4317 inside Docker.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_METRIC_EXPORT_INTERVAL=10000
# Set to false if your LLM provider rejects stream_options.include_usage.
LLM_INCLUDE_USAGE=true
